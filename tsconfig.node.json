{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/typescript/node.tsbuildinfo",
    "lib": ["ES2022"],
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "electron.vite.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/agent/**/*.ts",
    "src/desktop/**/*.ts",
    "src/providers/**/*.ts",
    "src/policy/**/*.ts",
    "src/observability/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
