# Development only. Copy to .env.local and keep the real credential outside Git.
# The Electron main process loads .env.local; renderer code never receives this key.
META_API_KEY=
GHOST_META_MODEL=muse-spark-1.3

# Host capabilities. On by default for local development; set any to 0 to lock it down.
# Shell commands auto-run in autonomous modes and ask for review step-by-step.
GHOST_ENABLE_HOST_SHELL=1
GHOST_ENABLE_ACCESSIBILITY=1
# Retains mission/checkpoint/learning content for restart recovery.
# Existing saved data is preserved when disabled. Goals/replies remain in chat history.
GHOST_RETAIN_TASK_CONTENT=1
