# Development only. Copy to .env.local and keep the real credential outside Git.
# The Electron main process loads .env.local; renderer code never receives this key.
META_API_KEY=
GHOST_META_MODEL=muse-spark-1.3

# Optional host capabilities. Leave disabled outside a disposable test OS.
# Every enabled shell command still requires individual approval.
GHOST_ENABLE_HOST_SHELL=0
GHOST_ENABLE_ACCESSIBILITY=0
# Retains mission/checkpoint/learning content for restart recovery. Off by default.
# Existing saved data is preserved when disabled. Goals/replies remain in chat history.
GHOST_RETAIN_TASK_CONTENT=0
